NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=learn2code
DB_USER=learn2code_user
DB_PASSWORD=change_me_local_password
DB_SSL=false

REDIS_URL=redis://127.0.0.1:6379

DATABASE_URL=postgresql://learn2code_user:change_me_local_password@127.0.0.1:15432/learn2code

# JWT access token
JWT_ACCESS_SECRET=change_me_with_at_least_32_random_bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=learn2code-api
JWT_AUDIENCE=learn2code-web

# Refresh token
REFRESH_TOKEN_TTL_DAYS=30

# OpenAI
AI_PROVIDER=mock
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_REQUEST_TIMEOUT_MS=30000